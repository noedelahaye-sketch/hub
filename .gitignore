# macOS
.DS_Store

# Secrets — ne doivent jamais entrer dans le repo, ni en clair ni dans l'historique.
# Seules l'URL du projet et la clé publique (anon) peuvent figurer dans le code.
.env
.env.*
*.pem

# Supabase CLI
supabase/.temp/
supabase/.branches/

# Les documents de travail de Yuno (brief « Terrain » et son pourquoi).
# Ils portent la stratégie éditoriale de Noé, ses cibles et son analyse
# personnelle ; le dépôt est public. Même règle que les contacts : ces
# données restent sur sa machine, seul ce qu'elles produisent est versionné.
Yuno/

# La collection Canela complète, déposée par Noé le 12 août 2026 : quatre
# familles × huit graisses × deux postures, 3,7 Mo. Le site n'en sert que
# quatre fichiers, copiés à plat dans fonts/ et versionnés. Le reste ne part
# pas sur GitHub Pages — c'est du poids, et autant de fontes commerciales
# publiées pour rien.
fonts/Canela_Collection/

# Éditeurs
.vscode/
.idea/

# Claude Code — réglages, agents et skills installés sur cette machine.
# Tout le dossier, et pas seulement les réglages : un skill tiers (Impeccable,
# installé le 24 août 2026) pèse plusieurs centaines de fichiers qui partiraient
# sinon sur GitHub Pages avec le site.
.claude/

# Le contexte produit d'Impeccable : un condensé de CLAUDE.md et des cahiers
# des charges, écrit pour cet outil. Ce sont les documents d'origine qui font
# autorité et qui sont versionnés — pas ce résumé, qui se périmerait à côté.
PRODUCT.md

# Ce que l'outil écrit en travaillant : instantanés de critique, réglages,
# état de son mode « live ». Ce sont ses notes, pas celles du hub — l'état des
# lieux et les cahiers des charges disent ce qui compte, et eux sont versionnés.
.impeccable/
